<!doctype html><html lang="en"><head><%- include("partials/head", { title: "Quick Task — Living Yard" }) %><script src="/scripts/quick-task.js" defer></script></head>
<body data-page="quick-task"><a class="skip-link" href="#main">Skip to main content</a><%- include("partials/topbar", { active: "home" }) %>
<main id="main" class="shell editor-page quick-task-page"><header class="page-head"><h1>Quick Task</h1></header><section class="editor-form" aria-label="Quick Task">
<fieldset class="form-field form-fieldset"><legend class="field-label">Zones</legend><div class="selectgrid" id="zoneGrid"></div></fieldset>
<div class="form-field"><label class="field-label" for="duration">Minutes</label><input type="number" class="input task-duration" id="duration" min="1" max="1440" value="15"><div class="presets" id="presets"><button type="button" class="preset" data-min="5">5 min</button><button type="button" class="preset active" data-min="15">15 min</button><button type="button" class="preset" data-min="30">30 min</button><button type="button" class="preset" data-min="45">45 min</button><button type="button" class="preset" data-min="60">60 min</button></div></div>
<output class="feedback" id="taskFeedback" aria-live="polite"></output><div class="form-actions"><button class="btn btn--primary" id="startBtn" type="button">Start watering</button><a class="btn" href="/">Cancel</a></div></section></main><%- include("partials/mobile-nav", { active: "home" }) %></body></html>
