<!doctype html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "Living Yard — Sprinkler system" }) %>
  <script src="/scripts/field.js" defer></script>
  <script src="/scripts/index.js" defer></script>
</head>
<body data-page="dashboard">
  <a class="skip-link" href="#main">Skip to main content</a>
  <%- include("partials/topbar", { active: "home" }) %>
  <main id="main" class="shell dashboard">
    <header class="page-head"><h1>Today</h1></header>

    <section id="sprinklerField" class="lawn-field" data-dashboard-section="field" data-testid="field" aria-label="Sprinkler field"></section>
    <output id="fieldMutationFeedback" class="field-mutation-feedback" aria-live="polite"></output>

    <section class="section-block" data-dashboard-section="schedules" aria-labelledby="schedulesHeading">
      <header class="section-head"><h2 id="schedulesHeading">Schedules</h2><a href="/schedules">All schedules</a></header>
      <div id="schedules" class="schedule-list" aria-live="polite"><p class="empty">No schedules</p></div>
    </section>

    <section class="section-block" data-dashboard-section="history" aria-labelledby="historyHeading">
      <header class="section-head"><h2 id="historyHeading">History</h2><a href="/activity">All activity</a></header>
      <div id="history" class="history-list" aria-live="polite"><p class="empty">No history</p></div>
    </section>
    <div class="freshness-line"><span data-testid="controller-freshness" aria-live="polite">Controller status current</span><button class="text-action" id="refreshController" type="button" aria-label="Refresh controller status">Refresh</button></div>

    <section class="qt-island" data-testid="quick-task-island" aria-labelledby="quickTaskHeading" hidden>
      <form id="quickTaskForm">
        <div class="qt-island-head">
          <div class="qt-copy"><h2 class="qt-heading" id="quickTaskHeading" data-testid="quick-task-heading">Quick Task</h2><span class="qt-context">Runs once, right now</span></div>
          <output class="qt-island-zones" id="quickTaskZones" data-testid="quick-task-zones"></output>
          <button class="qt-close" id="quickTaskClose" type="button" aria-label="Close Quick Task and deselect all zones"><span aria-hidden="true">✕</span></button>
        </div>
        <p class="qt-hint">Pick at least one zone to start · durations in minutes</p>
        <div class="qt-island-controls">
          <div id="quickDurations" class="qt-durations" role="group" aria-label="Duration"></div>
          <button class="qt-start" type="submit" disabled>Start</button>
        </div>
        <output id="quickMessage" class="qt-feedback" aria-live="polite"></output>
      </form>
    </section>
  </main>
  <%- include("partials/mobile-nav", { active: "home" }) %>
</body>
</html>
