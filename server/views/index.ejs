<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head", { title: "Verdant — Irrigation Control" }) %>
    <script src="/scripts/index.js" defer></script>
  </head>
  <body>
    <%- include("partials/topbar", { active: "home" }) %>

    <main class="shell">
      <section class="hero reveal d1">
        <p class="hero__eyebrow">Live System</p>
        <h1>Good day in the <em>garden</em>.</h1>
        <p class="hero__lead">
          Monitor every zone, fire off a quick soak, and keep your schedules
          running like clockwork — all from one calm console.
        </p>

        <div class="statusline" id="statusline">
          <div class="stat">
            <span class="stat__dot idle" id="sysDot"></span>
            <span class="stat__label">System</span>
            <span class="stat__value" id="sysValue">Connecting…</span>
          </div>
          <div class="stat">
            <span class="stat__dot water idle" id="zoneDot"></span>
            <span class="stat__label">Watering</span>
            <span class="stat__value" id="zoneValue">—</span>
          </div>
          <div class="stat">
            <span class="stat__dot idle"></span>
            <span class="stat__label">Schedules</span>
            <span class="stat__value" id="schedValue">—</span>
          </div>
        </div>
      </section>

      <!-- ZONE MAP -->
      <section class="section reveal d2">
        <div class="section__head">
          <h2>Zones <span class="section__count" id="zoneCount"></span></h2>
        </div>
        <div class="zonemap" id="zonemap"></div>
      </section>

      <!-- CURRENT TASKS -->
      <section class="section reveal d3">
        <div class="section__head">
          <h2>Running Now <span class="section__count" id="taskCount"></span></h2>
          <a href="/quick-task"><button class="btn btn--water btn--sm">+ Quick Task</button></a>
        </div>
        <div class="card-grid" id="tasks">
          <div class="empty">Connecting to controller…</div>
        </div>
      </section>

      <!-- SCHEDULES -->
      <section class="section reveal d4">
        <div class="section__head">
          <h2>Schedules <span class="section__count" id="schedCount"></span></h2>
          <a href="/create-schedule"><button class="btn btn--primary btn--sm">+ New Schedule</button></a>
        </div>
        <div class="card-grid" id="schedules">
          <div class="empty">Loading schedules…</div>
        </div>
      </section>

      <!-- HISTORY -->
      <section class="section reveal d5">
        <div class="section__head">
          <h2>History</h2>
        </div>
        <div class="panel" style="padding: 8px 22px">
          <div class="timeline" id="history">
            <div class="empty" style="border: none; background: none">Loading history…</div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
