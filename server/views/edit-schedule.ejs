<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head", { title: "Edit Schedule — Verdant" }) %>
    <script src="/scripts/edit-schedule.js" defer></script>
  </head>
  <body>
    <%- include("partials/topbar", { active: "" }) %>

    <main class="shell" style="max-width: 760px">
      <section class="hero reveal d1" style="padding-bottom: 18px">
        <p class="hero__eyebrow">Automation</p>
        <h1>Edit <em>schedule</em>.</h1>
        <p class="hero__lead">Adjust the timing, days, or watering sequence.</p>
      </section>

      <section class="panel form-panel reveal d2">
        <p class="subhead">General</p>

        <div class="field">
          <label class="field__label" for="scheduleName">Schedule Name</label>
          <input type="text" class="input schedule-name" id="scheduleName" placeholder="e.g. Morning Trees" />
        </div>

        <div class="form-grid">
          <div class="field">
            <label class="field__label" for="startTime">Start Time</label>
            <input type="time" class="input start-time" id="startTime" />
          </div>
          <div class="field">
            <span class="field__label">Repeat On</span>
            <div class="selectgrid selectgrid--days" id="dayGrid"></div>
          </div>
        </div>

        <div class="divider"></div>

        <p class="subhead">Tasks</p>
        <div class="card-grid tasks" id="taskList" style="margin-bottom: 20px"></div>

        <div class="builder">
          <div class="field">
            <span class="field__label">Zones for this task</span>
            <div class="selectgrid" id="zoneGrid"></div>
          </div>
          <div class="form-grid" style="align-items: end">
            <div class="field" style="margin-bottom: 0">
              <label class="field__label" for="duration">Duration (min)</label>
              <input type="number" class="input task-duration" id="duration" placeholder="15" min="1" value="15" />
            </div>
            <div class="field" style="margin-bottom: 0">
              <button class="btn btn--water btn--block add-task-btn" id="addTaskBtn">+ Add Task</button>
            </div>
          </div>
        </div>
      </section>

      <div class="actionbar reveal d3">
        <button class="btn btn--primary btn--lg btn--block save-btn" id="saveBtn">
          Save Changes
        </button>
      </div>

      <a href="/" class="backlink reveal d3">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to dashboard
      </a>
    </main>
  </body>
</html>
