<!doctype html><html lang="en"><head><%- include("partials/head", { title: "New schedule — Living Yard" }) %><script src="/scripts/create-schedule.js" defer></script></head>
<body data-page="create-schedule"><a class="skip-link" href="#main">Skip to main content</a><%- include("partials/topbar", { active: "schedules" }) %>
<main id="main" class="shell editor-page"><header class="page-head"><h1>New schedule</h1></header>
<section class="editor-form" aria-label="New schedule details">
  <div class="form-field"><label class="field-label" for="scheduleName">Name</label><input type="text" class="input schedule-name" id="scheduleName" maxlength="80" autocomplete="off"></div>
  <div class="form-grid"><div class="form-field"><label class="field-label" for="startTime">Start time</label><input type="time" class="input start-time" id="startTime" value="06:00"></div><fieldset class="form-field form-fieldset"><legend class="field-label">Days</legend><div class="selectgrid selectgrid--days" id="dayGrid"></div></fieldset></div>
  <div class="task-section"><h2 class="micro-heading">Sequence</h2><div class="tasks" id="taskList"></div></div>
  <div class="builder"><fieldset class="form-field form-fieldset"><legend class="field-label">Zones for next task</legend><div class="selectgrid" id="zoneGrid"></div></fieldset><div class="builder-controls"><div class="form-field"><label class="field-label" for="duration">Minutes</label><input type="number" class="input task-duration" id="duration" min="1" max="1440" value="15"></div><button class="btn" id="addTaskBtn" type="button">Add task</button></div></div>
  <output class="feedback" id="formFeedback" aria-live="polite"></output><div class="form-actions"><button class="btn btn--primary save-btn" id="saveBtn" type="button">Save schedule</button><a class="btn" href="/schedules">Cancel</a></div>
</section></main><%- include("partials/mobile-nav", { active: "schedules" }) %></body></html>
